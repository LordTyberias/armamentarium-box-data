# /etc/systemd/system/armamentarium-box-data-failure.service
#
# Started by systemd when armamentarium-box-data.service fails (OnFailure=), or by hand to check the mail way. It mails
# the maintainer what systemd hands over (MONITOR_*), nothing from the journal (ADR 0003 Addendum ARMAM-600). No timer,
# no token, no state; no OnFailure= of its own, so a mail that does not go out ends here, in the journal.

[Unit]
Description=Armamentarium box contents scraper: failure mail
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/dotnet /srv/armamentarium-box-data/current/Armamentarium.BoxData.Scraper.dll --notify-failure
TimeoutStartSec=2min

DynamicUser=yes
# .NET opens the per-user X509 store under $HOME on the TLS handshake (the trap of the scraper unit); a state directory
# of its own is the one place this unit may write.
StateDirectory=armamentarium-box-data-failure
Environment=HOME=%S/armamentarium-box-data-failure

LoadCredential=mail-password:/etc/armamentarium/mail-password

Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

# Sandboxing as for the web services; this one writes only its state directory.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
PrivateUsers=true
# Not ProcSubset=pid: the .NET runtime reads /proc/meminfo and the cgroup files for its memory limits.
SystemCallErrorNumber=EPERM
