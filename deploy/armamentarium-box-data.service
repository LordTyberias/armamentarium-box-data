# /etc/systemd/system/armamentarium-box-data.service
#
# The scraper service of ADR 0003: one run, started by armamentarium-box-data.timer.
# It opens pull requests in LordTyberias/armamentarium-box-data. With --auto-merge it
# merges each one itself (ADR 0004) until the table is filled, except the draft of
# orphaned ids (ADR 0004 Addendum ARMAM-597); without it, it opens
# drafts and never merges. No port, no restart, no sudoers line: the timer starts it.

[Unit]
Description=Armamentarium box contents scraper
After=network-online.target
Wants=network-online.target
# A failed run (exit code, the 20 h timeout, a start that never ran) mails the maintainer through this unit; the run itself
# mails its notices at its end (ADR 0003 Addendum ARMAM-600).
OnFailure=armamentarium-box-data-failure.service

[Service]
Type=oneshot
# Remove --auto-merge (daemon-reload) when the maintainer merges by hand again.
ExecStart=/usr/bin/dotnet /srv/armamentarium-box-data/current/Armamentarium.BoxData.Scraper.dll --auto-merge
# A pass over the whole backlog takes hours (five seconds per request and shop,
# up to ten for a shop that throttles, so about 19 hours at worst; the shops are
# asked side by side, so a further shop adds no time). The catch-up at its end
# can add about five more; a run stopped by the timeout resumes from its saved
# state.
TimeoutStartSec=20h

# A throwaway account per run; the state survives in /var/lib/armamentarium-box-data,
# passed in as $STATE_DIRECTORY.
DynamicUser=yes
StateDirectory=armamentarium-box-data
# The dynamic account has no home directory, but .NET opens the per-user X509 store
# under $HOME on every TLS handshake and fails without one ("The home directory of the
# current user could not be determined", measured on the first run). The state
# directory is the one place this service may write.
Environment=HOME=%S/armamentarium-box-data

# The GitHub token reaches the service from here and from nowhere else: systemd
# reads the root-owned 0600 file and hands it over as $CREDENTIALS_DIRECTORY/github-token.
# Never Environment=, which would show the value in systemctl show.
LoadCredential=github-token:/etc/armamentarium-box-data/github-token
# The mail password of the Armamentarium web services, the same file and the same way in: one mailbox, one password,
# one rotation (docs/server/betrieb.md in the main repository).
LoadCredential=mail-password:/etc/armamentarium/mail-password

Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

# Sandboxing as for the web services; this one writes only its state directory.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
PrivateUsers=true
# Not ProcSubset=pid: the .NET runtime reads /proc/meminfo and the cgroup files for its memory limits.
SystemCallErrorNumber=EPERM
