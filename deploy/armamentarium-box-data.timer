# /etc/systemd/system/armamentarium-box-data.timer
#
# On the 1st and the 15th of every month (ADR 0004). Persistent catches a run missed
# while the server was down.

[Unit]
Description=Fortnightly run of the Armamentarium box contents scraper

[Timer]
OnCalendar=*-*-01,15 03:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
