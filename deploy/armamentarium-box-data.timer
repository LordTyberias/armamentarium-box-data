# /etc/systemd/system/armamentarium-box-data.timer
#
# Once a day (ADR 0003 §2). Persistent catches a run missed while the server was down.

[Unit]
Description=Daily run of the Armamentarium box contents scraper

[Timer]
OnCalendar=*-*-* 03:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
